<?xml version="1.0" encoding="UTF-8" ?>
<!--
  禁用 FastDDS 共享内存（SHM）传输，改用纯 UDPv4 本地回环。
  根治 systemctl restart c50c-nav2.service 后 /dev/shm/fastrtps_port* 残留
  锁/段导致的 nav_relay 订阅哑火（topic info 显示匹配但回调 0 到达）问题。
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>udp_transport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="c50c_nav2_udp" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>udp_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
